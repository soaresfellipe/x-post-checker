{
  "name": "amplifyx",
  "version": "0.1.0",
  "private": true,
  "description": "AmplifyX: viral-potential assistant for X (Chrome + Firefox MV3)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "0.21.4"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:test": "wxt build --mode e2e",
    "package": "tsx scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "pnpm build:firefox && web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "test": "pnpm test:unit && pnpm test:dom && pnpm test:e2e",
    "test:unit": "vitest run test/unit",
    "test:dom": "vitest run test/dom",
    "test:e2e": "playwright test",
    "test:real-x": "pnpm build:chrome && node scripts/real-x-smoke.mjs",
    "fixture": "tsx scripts/fixture-server.ts",
    "parity": "tsx scripts/parity/run.ts --browser=both",
    "parity:chrome": "tsx scripts/parity/run.ts --browser=chrome",
    "smoke:firefox": "tsx scripts/parity/run.ts --browser=firefox",
    "verify:packages": "pnpm package && tsx scripts/verify-packages.ts"
  }
}

{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [".wxt/wxt.d.ts", "src", "test", "scripts", "*.ts"],
  "exclude": ["node_modules", ".output", "build"]
}
